{
  "name": "fileflyer",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:portable": "tauri build --no-bundle && powershell -NoProfile -Command \"New-Item -ItemType Directory -Force dist-portable | Out-Null; Copy-Item src-tauri/target/release/fileflyer.exe dist-portable/FileFlyer-portable.exe -Force\"",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --debug --target x86_64",
    "android:build:release": "tauri android build --apk",
    "android:build:aab": "tauri android build --aab",
    "android:install": "adb install -r src-tauri/gen/android/app/build/outputs/apk/universal/debug/app-universal-debug.apk",
    "android:launch": "adb shell am start -n com.fileflyer.transfer/.MainActivity",
    "android:run": "npm run android:build && npm run android:install && npm run android:launch",
    "android:prod": "tauri android run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.10",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
